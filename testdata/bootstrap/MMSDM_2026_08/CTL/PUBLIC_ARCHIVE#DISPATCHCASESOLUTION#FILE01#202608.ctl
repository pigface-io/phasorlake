LOAD DATA
INFILE PUBLIC_ARCHIVE#DISPATCHCASESOLUTION#FILE01#202608010000.CSV
APPEND INTO TABLE DISPATCHCASESOLUTION
WHEN (1:1) = 'D'
FIELDS TERMINATED BY ','
