-- Title:	PUBLIC_ARCHIVE#DUDETAIL#FILE01#202410.ctl
-- ************************************************************
-- Project : NEMMCO MONTHLY DVD RELEASE
-- Purpose : Control File to load monthly csv file
-- Target Application  : Monthly DVD Release
-- Application Version : 1
-- Visibility Id : PUBLIC
--
-- ************************************************************
-- Special Instructions : 1. USER TO CONNECT AS DUDETAIL owner
--
-- ************************************************************
-- History :
--      MMS Data Model Version   Template Generated On
--      ======================   ======================
--      PUBLIC			       v
-- ************************************************************
LOAD DATA
INFILE PUBLIC_ARCHIVE#DUDETAIL#FILE01#202410010000.CSV
APPEND INTO TABLE DUDETAIL
WHEN (1:1) = 'D'
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(row_type FILLER,
report_type FILLER,
report_subtype FILLER,
report_version FILLER,
EFFECTIVEDATE DATE "YYYY/MM/DD HH24:MI:SS",
DUID CHAR(10),
VERSIONNO FLOAT EXTERNAL,
CONNECTIONPOINTID CHAR(10),
VOLTLEVEL CHAR(10),
REGISTEREDCAPACITY FLOAT EXTERNAL,
AGCCAPABILITY CHAR(1),
DISPATCHTYPE CHAR(20),
MAXCAPACITY FLOAT EXTERNAL,
STARTTYPE CHAR(20),
NORMALLYONFLAG CHAR(1),
PHYSICALDETAILSFLAG CHAR(1),
SPINNINGRESERVEFLAG CHAR(1),
AUTHORISEDBY CHAR(15),
AUTHORISEDDATE DATE "YYYY/MM/DD HH24:MI:SS",
LASTCHANGED DATE "YYYY/MM/DD HH24:MI:SS",
INTERMITTENTFLAG CHAR(1),
SEMISCHEDULE_FLAG CHAR(1),
MAXRATEOFCHANGEUP FLOAT EXTERNAL,
MAXRATEOFCHANGEDOWN FLOAT EXTERNAL,
DISPATCHSUBTYPE CHAR(20),
ADG_ID CHAR(20),
MINCAPACITY FLOAT EXTERNAL,
REGISTEREDMINCAPACITY FLOAT EXTERNAL,
MAXRATEOFCHANGEUP_LOAD FLOAT EXTERNAL,
MAXRATEOFCHANGEDOWN_LOAD FLOAT EXTERNAL,
MAXSTORAGECAPACITY FLOAT EXTERNAL,
STORAGEIMPORTEFFICIENCYFACTOR FLOAT EXTERNAL,
STORAGEEXPORTEFFICIENCYFACTOR FLOAT EXTERNAL,
MIN_RAMP_RATE_UP FLOAT EXTERNAL,
MIN_RAMP_RATE_DOWN FLOAT EXTERNAL,
LOAD_MIN_RAMP_RATE_UP FLOAT EXTERNAL,
LOAD_MIN_RAMP_RATE_DOWN FLOAT EXTERNAL,
AGGREGATED FLOAT EXTERNAL)
-- End of Script
