  "schemas": [
    {
      "fields": [
        {
          "doc": "ID uniquely identifying the outage",
          "id": 1,
          "name": "OUTAGEID",
          "required": true,
          "type": "long"
        },
        {
          "doc": "The substation this equipment is located at",
          "id": 2,
          "name": "SUBSTATIONID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "The type of equipment. Valid values are:\nLINE = Line\nTRANS = Transformer\nCB = Circuit breaker\nISOL = Isolator\nCAP = Capacitor\nREAC = Reactor\nUNIT = Unit",
          "id": 3,
          "name": "EQUIPMENTTYPE",
          "required": true,
          "type": "string"
        },
        {
          "doc": "A unique identifier for this equipment at this substation, and based on its type",
          "id": 4,
          "name": "EQUIPMENTID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "The planned starting date and time of the outage",
          "id": 5,
          "name": "STARTTIME",
          "required": true,
          "type": "timestamptz"
        },
        {
          "doc": "The planned ending date and time of the outage",
          "id": 6,
          "name": "ENDTIME",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The date and time this outage was first submitted",
          "id": 7,
          "name": "SUBMITTEDDATE",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "A code representing the status of the outage.\nThe OUTAGESTATUSCODE table will store a detailed description of each code.",
          "id": 8,
          "name": "OUTAGESTATUSCODE",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Changes to an outage key details may require the outage to be resubmitted.\nA new outage id will then be allocated and the outage will be reassessed.\nThis field will detail the reason for the change.",
          "id": 9,
          "name": "RESUBMITREASON",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The new outage id created from a resubmit.",
          "id": 10,
          "name": "RESUBMITOUTAGEID",
          "required": false,
          "type": "decimal(15, 0)"
        },
        {
          "doc": "The recall time in minutes during the day",
          "id": 11,
          "name": "RECALLTIMEDAY",
          "required": false,
          "type": "decimal(10, 0)"
        },
        {
          "doc": "The recall time in minutes during the night",
          "id": 12,
          "name": "RECALLTIMENIGHT",
          "required": false,
          "type": "decimal(10, 0)"
        },
        {
          "doc": "The time that this record was last changed",
          "id": 13,
          "name": "LASTCHANGED",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The reason provided by the asset owner for this outage",
          "id": 14,
          "name": "REASON",
          "required": false,
          "type": "string"
        },
        {
          "doc": "1 = The outage is for a secondary piece of equipment that has an associated constraint set. The transmission equipment is still in service. 0 = The outage is for the transmission equipment",
          "id": 15,
          "name": "ISSECONDARY",
          "required": false,
          "type": "decimal(1, 0)"
        },
        {
          "doc": "The actual starting date/time of the outage",
          "id": 16,
          "name": "ACTUAL_STARTTIME",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The actual ending date/time of the outage",
          "id": 17,
          "name": "ACTUAL_ENDTIME",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The asset owners reference code for this outage",
          "id": 18,
          "name": "COMPANYREFCODE",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Equipment element id",
          "id": 19,
          "name": "ELEMENTID",
          "required": false,
          "type": "decimal(15, 0)"
        }
      ],
