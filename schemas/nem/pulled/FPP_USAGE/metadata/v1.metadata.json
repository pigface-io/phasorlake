    {
      "fields": [
        {
          "doc": "Date and time of the trading interval (DD/MM/YYYY HH24:MI:SS) fixed to the UTC+10 time zone (NEM time)",
          "id": 1,
          "name": "INTERVAL_DATETIME",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "Constraint ID (binding constraint ID from FCAS data used in FPP calculations)",
          "id": 2,
          "name": "CONSTRAINTID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Version (FPP run number from the FPP database)",
          "id": 3,
          "name": "VERSIONNO",
          "required": false,
          "type": "decimal(5, 0)"
        },
        {
          "doc": "Bid type (the bid type saved in relation to constraint ID from FCAS data used in FPP calculations)",
          "id": 4,
          "name": "BIDTYPE",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Enabled regulation MW used in the FPP calculation (from FPP database)",
          "id": 5,
          "name": "REGULATION_MW",
          "required": false,
          "type": "decimal(18, 8)"
        },
        {
          "doc": "Maximum used regulation MW value (quantity of regulation FCAS that was calculated to be used in MW)",
          "id": 6,
          "name": "USED_MW",
          "required": false,
          "type": "decimal(18, 8)"
        },
        {
          "doc": "Usage (calculation of the proportion of regulation FCAS that was calculated to be used)",
          "id": 7,
          "name": "USAGE",
          "required": false,
          "type": "decimal(18, 8)"
        },
        {
          "doc": "The reason flag showing the decision matrix for the usage calculation Supported values are: 0 = Usage is calculated based on good input data 1 = Usage is 0 as FM is unreliable 2 = Usage is 0 as the percentage of units with unavailable input or bad data is greater than the threshold percentage",
          "id": 8,
          "name": "USAGE_REASON_FLAG",
          "required": false,
          "type": "decimal(5, 0)"
        }
