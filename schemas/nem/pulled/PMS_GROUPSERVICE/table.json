{
  "columns": [
    {
      "comment": "Record identifier of the Service allocated to the Group. When data is updated, existing record identifier is terminated, and new record identifier(s) are allocated.",
      "id": 1,
      "model_type": "NUMERIC(20,0)",
      "name": "GROUPSERVICEID"
    },
    {
      "comment": "Group id of the Group where the Service is attached to.",
      "id": 2,
      "model_type": "NUMERIC(20,0)",
      "name": "GROUPID"
    },
    {
      "comment": "Date for which this version is effective from.",
      "id": 3,
      "model_type": "TIMESTAMP(3)",
      "name": "VERSIONFROM"
    },
    {
      "comment": "Date for which this version is effective to. Will be set to max date 9999/12/31 23:59:59.999 until this version ends or a change to the version is required.",
      "id": 4,
      "model_type": "TIMESTAMP(3)",
      "name": "VERSIONTO"
    },
