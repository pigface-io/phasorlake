      "model_type": "TIMESTAMP(3)",
      "name": "ENDDATE"
    },
    {
      "comment": "Market that this group is operating its service in. Will only be NEM initially.",
      "id": 7,
      "model_type": "VARCHAR(50)",
      "name": "MARKET"
    },
    {
      "comment": "Service that this group is operating. Will be only be ENERGY initially",
      "id": 8,
      "model_type": "VARCHAR(50)",
      "name": "SERVICETYPE"
    },
    {
      "comment": "Describes the entity that is operating. Will only be WDRU initially.",
      "id": 9,
      "model_type": "VARCHAR(50)",
      "name": "ENTITYTYPE"
    },
    {
      "comment": "Describe the entity ID in the market that it will be operating in. Will only contain the DUID of the group initially.",
      "id": 10,
      "model_type": "VARCHAR(50)",
      "name": "ENTITYID"
    },
    {
      "comment": "Maximum responsive component for the service offering",
      "id": 11,
      "model_type": "NUMERIC(10,3)",
      "name": "MRC"
    },
    {
      "comment": "Reason for the MRC.",
      "id": 12,
      "model_type": "VARCHAR(500)",
      "name": "MRCREASON"
    },
    {
      "comment": "Maximum ramp rate MW per minute of the service.",
      "id": 13,
      "model_type": "NUMERIC(10,0)",
      "name": "MAXIMUMRAMPRATEPERMIN"
    },
    {
      "comment": "Region the group is operating this service in One of NSW1, QLD1, VIC1, SA1 or TAS1",
