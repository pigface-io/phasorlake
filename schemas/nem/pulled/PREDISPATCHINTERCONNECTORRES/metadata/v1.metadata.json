  "schemas": [
    {
      "fields": [
        {
          "doc": "Unique identifier of predispatch run in the form YYYYMMDDPP with 01 at 04:30",
          "id": 1,
          "name": "PREDISPATCHSEQNO",
          "required": false,
          "type": "decimal(10, 0)"
        },
        {
          "doc": "SPD Predispatch run no, typically 1. It increments if the case is re-run.",
          "id": 2,
          "name": "RUNNO",
          "required": false,
          "type": "decimal(3, 0)"
        },
        {
          "doc": "Interconnector identifier",
          "id": 3,
          "name": "INTERCONNECTORID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "PERIODID is just a period count, starting from 1 for each predispatch run. Use DATETIME to determine half hour period.",
          "id": 4,
          "name": "PERIODID",
          "required": false,
          "type": "decimal(2, 0)"
        },
        {
          "doc": "Flag to indicate if this result set was sourced from the pricing run (INTERVENTION=0) or the physical run (INTERVENTION=1). In the event that there is not intervention in the market, both pricing and physical runs correspond to INTERVENTION=0",
          "id": 5,
          "name": "INTERVENTION",
          "required": false,
          "type": "decimal(2, 0)"
        },
        {
          "doc": "Metered MW Flow from EMS. For periods subsequent to the first period of a Pre-Dispatch run, this value represents the cleared target for the previous period of that Pre-Dispatch run.",
          "id": 6,
          "name": "METEREDMWFLOW",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Calculated MW Flow",
          "id": 7,
          "name": "MWFLOW",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Calculated MW Losses",
          "id": 8,
          "name": "MWLOSSES",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "$ Marginal value of interconnector constraint from SPD",
          "id": 9,
          "name": "MARGINALVALUE",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Degree of violation of interconnector constraint in MW",
          "id": 10,
          "name": "VIOLATIONDEGREE",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Last changed.",
          "id": 11,
          "name": "LASTCHANGED",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "Period date and time",
          "id": 12,
          "name": "DATETIME",
          "required": true,
          "type": "timestamptz"
        },
        {
          "doc": "Calculated export limit.",
          "id": 13,
          "name": "EXPORTLIMIT",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Calculated import limit.",
          "id": 14,
          "name": "IMPORTLIMIT",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Marginal loss factor. Use this to adjust bids between reports.",
          "id": 15,
          "name": "MARGINALLOSS",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Generic Constraint setting the export limit",
          "id": 16,
          "name": "EXPORTGENCONID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Generic Constraint setting the import limit",
          "id": 17,
          "name": "IMPORTGENCONID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Calculated export limit applying to energy + FCAS.",
          "id": 18,
          "name": "FCASEXPORTLIMIT",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Calculated import limit applying to energy + FCAS.",
          "id": 19,
          "name": "FCASIMPORTLIMIT",
          "required": false,
          "type": "decimal(15, 5)"
        }
