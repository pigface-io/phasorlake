  "properties": {
    "comment": "PREDISPATCHINTERCONNECTORRES records Interconnector flows and losses for the periods calculated in each predispatch run. Only binding and interconnector constraints are reported.\nSome fields are for the Frequency Controlled Ancillary Services export and import limits and extra reporting of the generic constraint setting the energy import and export limits.",
    "utilake.declared": "true",
    "utilake.format": "3",
    "utilake.key": "[\"INTERCONNECTORID\",\"DATETIME\"]",
    "utilake.load": "append",
