{
  "columns": [
    {
      "comment": "Unique identifier of predispatch run in the form YYYYMMDDPP with 01 at 04:30",
      "id": 1,
      "model_type": "VARCHAR(20)",
      "name": "PREDISPATCHSEQNO"
    },
    {
      "comment": "SPD Predispatch run no, typically 1. It increments if the case is re-run.",
      "id": 2,
      "model_type": "NUMERIC(3,0)",
      "name": "RUNNO"
    },
    {
      "comment": "Interconnector identifier",
      "id": 3,
      "model_type": "VARCHAR(10)",
      "name": "INTERCONNECTORID"
    },
    {
      "comment": "PERIODID is just a period count, starting from 1 for each predispatch run. Use DATETIME to determine half hour period.",
      "id": 4,
      "model_type": "VARCHAR(20)",
      "name": "PERIODID"
    },
    {
      "comment": "Flag to indicate if this result set was sourced from the pricing run (INTERVENTION=0) or the physical run (INTERVENTION=1). In the event that there is not intervention in the market, both pricing and physical runs correspond to INTERVENTION=0",
      "id": 5,
      "model_type": "NUMERIC(2,0)",
      "name": "INTERVENTION"
    },
    {
      "comment": "Metered MW Flow from EMS. For periods subsequent to the first period of a Pre-Dispatch run, this value represents the cleared target for the previous period of that Pre-Dispatch run.",
      "id": 6,
      "model_type": "NUMERIC(15,5)",
      "name": "METEREDMWFLOW"
    },
    {
      "comment": "Calculated MW Flow",
      "id": 7,
      "model_type": "NUMERIC(15,5)",
      "name": "MWFLOW"
    },
    {
      "comment": "Calculated MW Losses",
      "id": 8,
      "model_type": "NUMERIC(15,5)",
      "name": "MWLOSSES"
    },
    {
      "comment": "$ Marginal value of interconnector constraint from SPD",
      "id": 9,
      "model_type": "NUMERIC(15,5)",
      "name": "MARGINALVALUE"
    },
    {
      "comment": "Degree of violation of interconnector constraint in MW",
      "id": 10,
      "model_type": "NUMERIC(15,5)",
      "name": "VIOLATIONDEGREE"
    },
    {
      "comment": "Last changed.",
      "id": 11,
      "model_type": "TIMESTAMP(0)",
      "name": "LASTCHANGED"
    },
    {
      "comment": "Period date and time",
      "id": 12,
      "model_type": "TIMESTAMP(0)",
      "name": "DATETIME"
    },
    {
      "comment": "Calculated export limit.",
      "id": 13,
      "model_type": "NUMERIC(15,5)",
      "name": "EXPORTLIMIT"
    },
    {
      "comment": "Calculated import limit.",
      "id": 14,
      "model_type": "NUMERIC(15,5)",
      "name": "IMPORTLIMIT"
    },
    {
      "comment": "Marginal loss factor. Use this to adjust bids between reports.",
      "id": 15,
      "model_type": "NUMERIC(15,5)",
      "name": "MARGINALLOSS"
    },
    {
      "comment": "Generic Constraint setting the export limit",
      "id": 16,
      "model_type": "VARCHAR(20)",
      "name": "EXPORTGENCONID"
    },
    {
      "comment": "Generic Constraint setting the import limit",
      "id": 17,
      "model_type": "VARCHAR(20)",
      "name": "IMPORTGENCONID"
    },
    {
      "comment": "Calculated export limit applying to energy + FCAS.",
      "id": 18,
      "model_type": "NUMERIC(15,5)",
      "name": "FCASEXPORTLIMIT"
    },
    {
      "comment": "Calculated import limit applying to energy + FCAS.",
      "id": 19,
      "model_type": "NUMERIC(15,5)",
      "name": "FCASIMPORTLIMIT"
    },
    {
      "comment": "Aggregate Constraint contribution cost of this Interconnector: Sum(MarginalValue x Factor) for all relevant Constraints, for Export (Factor >= 0)",
      "id": 20,
      "model_type": "NUMERIC(10,2)",
      "name": "LOCAL_PRICE_ADJUSTMENT_EXPORT"
    },
    {
      "comment": "Key for Local_Price_Adjustment_Export: 2 = at least one Outage Constraint; 1 = at least 1 System Normal Constraint (and no Outage Constraint); 0 = No System Normal or Outage Constraints",
      "id": 21,
      "model_type": "NUMERIC(1,0)",
      "name": "LOCALLY_CONSTRAINED_EXPORT"
    },
    {
      "comment": "Aggregate Constraint contribution cost of this Interconnector: Sum(MarginalValue x Factor) for all relevant Constraints, for Import (Factor >= 0)",
      "id": 22,
      "model_type": "NUMERIC(10,2)",
      "name": "LOCAL_PRICE_ADJUSTMENT_IMPORT"
    },
    {
      "comment": "Key for Local_Price_Adjustment_Import: 2 = at least one Outage Constraint; 1 = at least 1 System Normal Constraint (and no Outage Constraint); 0 = No System Normal or Outage Constraints",
      "id": 23,
      "model_type": "NUMERIC(1,0)",
      "name": "LOCALLY_CONSTRAINED_IMPORT"
    }
  ],
  "declared": true,
  "description": "PREDISPATCHINTERCONNECTORRES records Interconnector flows and losses for the periods calculated in each predispatch run. Only binding and interconnector constraints are reported.\nSome fields are for the Frequency Controlled Ancillary Services export and import limits and extra reporting of the generic constraint setting the energy import and export limits.",
