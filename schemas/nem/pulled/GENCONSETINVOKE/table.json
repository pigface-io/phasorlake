{
  "columns": [
    {
      "comment": "Abstract unique identifier for the record. Allows Invocations to be modified without affecting PK values",
      "id": 1,
      "model_type": "NUMERIC(9)",
      "name": "INVOCATION_ID"
    },
    {
      "comment": "Market date of start",
      "id": 2,
      "model_type": "TIMESTAMP(0)",
      "name": "STARTDATE"
    },
    {
      "comment": "The first dispatch interval of the invocation being the dispatch interval number starting from1 at 04:05.",
      "id": 3,
      "model_type": "NUMERIC(3,0)",
      "name": "STARTPERIOD"
    },
    {
      "comment": "Unique generic constraint set identifier",
      "id": 4,
      "model_type": "VARCHAR(20)",
      "name": "GENCONSETID"
    },
    {
      "comment": "Market date end",
      "id": 5,
      "model_type": "TIMESTAMP(0)",
      "name": "ENDDATE"
    },
    {
      "comment": "Dispatch interval number end",
      "id": 6,
      "model_type": "NUMERIC(3,0)",
      "name": "ENDPERIOD"
    },
    {
      "comment": "User authorising invoke, indicating a constraint set invocation is applicable (i.e. non-null). A null value indicates inactive invocation.",
      "id": 7,
      "model_type": "VARCHAR(15)",
      "name": "STARTAUTHORISEDBY"
    },
    {
      "comment": "user authorising revoke.",
      "id": 8,
      "model_type": "VARCHAR(15)",
      "name": "ENDAUTHORISEDBY"
    },
    {
      "comment": "0 is not intervention, 1 is intervention and causes dispatch to solve twice.",
      "id": 9,
      "model_type": "VARCHAR(1)",
      "name": "INTERVENTION"
    },
    {
      "comment": "Constraint type (e.g. ancillary services). This also flags where a constraint is an interconnector or intra-region network limit.",
      "id": 10,
      "model_type": "VARCHAR(10)",
      "name": "ASCONSTRAINTTYPE"
    },
    {
      "comment": "Last date and time record changed",
      "id": 11,
      "model_type": "TIMESTAMP(0)",
      "name": "LASTCHANGED"
    },
    {
      "comment": "The settlement date and time corresponding to the first interval to which the constraint set is to be applied.",
      "id": 12,
      "model_type": "TIMESTAMP(0)",
      "name": "STARTINTERVALDATETIME"
    },
    {
      "comment": "The settlement date and time corresponding to the last interval to which the constraint set is to be applied.",
      "id": 13,
      "model_type": "TIMESTAMP(0)",
      "name": "ENDINTERVALDATETIME"
    },
    {
      "comment": "Flag to indicate if the constraint set is a system normal (1) or an outage set (0)",
      "id": 14,
      "model_type": "VARCHAR(1)",
      "name": "SYSTEMNORMAL"
    }
  ],
  "declared": true,
  "description": "GENCONSETINVOKE provides details of invoked and revoked generic constraints. GENCONSETINVOKE is the key table for determining what constraints are active in dispatch, predispatch and PASA.\nGENCONSETINVOKE also indicates whether constraints are for interconnector limits, ancillary services, etc.",
