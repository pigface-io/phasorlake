  "schemas": [
    {
      "fields": [
        {
          "doc": "ID uniquely identifying the substation this equipment is located at",
          "id": 1,
          "name": "SUBSTATIONID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "The type of equipment. Valid values are:\nLINE = Line\nTRANS = Transformer\nCB = Circuit breaker\nISOL = Isolator\nCAP = Capacitor\nREAC = Reactor\nUNIT = Unit",
          "id": 2,
          "name": "EQUIPMENTTYPE",
          "required": true,
          "type": "string"
        },
        {
          "doc": "A unique identifier for this type of equipment at this substation",
          "id": 3,
          "name": "EQUIPMENTID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "The date that this record is applies from (inclusive)",
          "id": 4,
          "name": "VALIDFROM",
          "required": true,
          "type": "timestamptz"
        },
        {
          "doc": "The date that this record applies until (exclusive)",
          "id": 5,
          "name": "VALIDTO",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The voltage in KV for this equipment.\nTransformers may have multiple voltages defined.\nE.g. 132_110_33",
          "id": 6,
          "name": "VOLTAGE",
          "required": false,
          "type": "string"
        },
        {
          "doc": "A short description for this equipment.",
          "id": 7,
          "name": "DESCRIPTION",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The time that this record was last changed.",
          "id": 8,
          "name": "LASTCHANGED",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "Equipment element id",
