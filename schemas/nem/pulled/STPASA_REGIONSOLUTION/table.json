{
  "columns": [
    {
      "comment": "Unique Timestamp Identifier for this run, identified by the nominal start time of the run.",
      "id": 1,
      "model_type": "TIMESTAMP(0)",
      "name": "RUN_DATETIME"
    },
    {
      "comment": "End date time of the interval.",
      "id": 2,
      "model_type": "TIMESTAMP(0)",
      "name": "INTERVAL_DATETIME"
    },
    {
      "comment": "Region Identifier",
      "id": 3,
      "model_type": "VARCHAR(10)",
      "name": "REGIONID"
    },
    {
      "comment": "10% Probability of Exceedance demand forecast.",
      "id": 4,
      "model_type": "NUMERIC(12,2)",
      "name": "DEMAND10"
    },
    {
      "comment": "50% Probability of Exceedance demand forecast.",
      "id": 5,
      "model_type": "NUMERIC(12,2)",
      "name": "DEMAND50"
    },
    {
      "comment": "90% Probability of Exceedance demand forecast.",
      "id": 6,
      "model_type": "NUMERIC(12,2)",
      "name": "DEMAND90"
    },
    {
      "comment": "Reserve Requirement (MW). This field is not populated after 30 July 2025.",
      "id": 7,
      "model_type": "NUMERIC(12,2)",
      "name": "RESERVEREQ"
    },
    {
      "comment": "Demand + Reserve requirements (MW). This field is not populated after 30 July 2025.",
      "id": 8,
      "model_type": "NUMERIC(12,2)",
      "name": "CAPACITYREQ"
    },
    {
      "comment": "Sum of: (Region Demand50)/Period (sum by trading day, entered in first period of trading day, GWh).",
      "id": 9,
      "model_type": "NUMERIC(12,2)",
      "name": "ENERGYREQDEMAND50"
    },
    {
      "comment": "Aggregate generation + WDR capacity from Non-Energy Constrained plant subjected to restrictions due to network constraints.",
      "id": 10,
      "model_type": "NUMERIC(12,0)",
      "name": "UNCONSTRAINEDCAPACITY"
    },
    {
      "comment": "Aggregate generation + WDR capacity from Energy Constrained plant subjected to restrictions due to network constraints.",
      "id": 11,
      "model_type": "NUMERIC(12,0)",
      "name": "CONSTRAINEDCAPACITY"
    },
    {
      "comment": "Net export (MW) out of this region in the LOR evaluation. Export if > 0, Import if < 0. This value is the same as LORNETINTERCHANGEUNDERSCARCITY.",
      "id": 12,
      "model_type": "NUMERIC(12,2)",
      "name": "NETINTERCHANGEUNDERSCARCITY"
    },
    {
      "comment": "Regional surplus capacity (MW), +/- values indicate surplus/deficit capacity respectively. This value reflects Regional LOR reserve.",
      "id": 13,
      "model_type": "NUMERIC(12,2)",
      "name": "SURPLUSCAPACITY"
    },
    {
      "comment": "Regional surplus reserve (MW). This value also reflects Regional LOR reserve. Note: For LOR runs, RESERVEREQ requirement input is not used.",
      "id": 14,
      "model_type": "NUMERIC(12,2)",
      "name": "SURPLUSRESERVE"
    },
    {
      "comment": "Regional reserve condition from LRC run. This field is not populated after 30 July 2025.",
      "id": 15,
      "model_type": "NUMERIC(1,0)",
      "name": "RESERVECONDITION"
    },
    {
      "comment": "Maximum Surplus Reserve (MW) evaluated for this region from LRC runs. This field is no longer populated.",
      "id": 16,
      "model_type": "NUMERIC(12,2)",
      "name": "MAXSURPLUSRESERVE"
    },
    {
      "comment": "Maximum Spare Capacity (MW) evaluated for this region. Calculated for each region in turn. This value reflects Regional LOR reserve.",
      "id": 17,
      "model_type": "NUMERIC(12,2)",
      "name": "MAXSPARECAPACITY"
    },
    {
      "comment": "The LOR Condition determined from the Maximum Spare Capacity value: 0 - no condition, 1 - LOR1 condition, 2 - LOR2 condition, 3 - LOR3 condition",
      "id": 18,
      "model_type": "NUMERIC(1,0)",
      "name": "LORCONDITION"
    },
    {
      "comment": "Sum of MAXAVAIL quantities offered by all Scheduled units and Availability of all semi-scheduled units limited by MAXAVAIL in a given Region for a given PERIODID",
      "id": 19,
      "model_type": "NUMERIC(12,2)",
      "name": "AGGREGATECAPACITYAVAILABLE"
    },
    {
      "comment": "Sum of  MAXAVAIL quantities bid by of all Scheduled Loads in a given Region for a given PERIODID.",
      "id": 20,
      "model_type": "NUMERIC(12,2)",
      "name": "AGGREGATESCHEDULEDLOAD"
    },
    {
      "comment": "Date time this record was created.",
      "id": 21,
      "model_type": "TIMESTAMP(0)",
      "name": "LASTCHANGED"
    },
    {
      "comment": "Sum of PASAAVAILABILITY for all scheduled generating units and scheduled bidirectional units (Gen side) with a Recall_Period <= 24 hours plus the sum of Unconstrained Intermittent Generation Forecasts (UIGF) for all semi-scheduled generating units. For the RELIABILITY_LRC and OUTAGE_LRC runs, UIGF is the POE90 forecast. For the LOR Run, UIGF is the POE50 forecast. Note that the RELIABILITY_LRC and OUTAGE_LRC Run Types are discontinued from 31 July 2025. From March 2026, AGGREGATEPASAAVAILABILITY changes from that with Recall_Period <= 24 to that achievable by the relevant INTERVAL_DATETIME if recalled at the start of the run.",
      "id": 22,
      "model_type": "NUMERIC(12,0)",
      "name": "AGGREGATEPASAAVAILABILITY"
    },
    {
      "comment": "Type of run. Values are RELIABILITY_LRC, OUTAGE_LRC and LOR. Note that the STPASA RELIABILITY_LRC and OUTAGE_LRC Run Types are discontinued from 31 July 2025, with only the LOR Run Type reported.",
      "id": 23,
      "model_type": "VARCHAR(20)",
      "name": "RUNTYPE"
    },
    {
      "comment": "Energy (GWh) required for this energy block based on the 10% probability of exceedance demand. Listed in the first interval of the energy block",
      "id": 24,
      "model_type": "NUMERIC(12,2)",
      "name": "ENERGYREQDEMAND10"
    },
    {
      "comment": "Region Reserve Level for LOR1 used. Can be static value or calculated value if an interconnector is a credible contingency",
      "id": 25,
      "model_type": "NUMERIC(16,6)",
      "name": "CALCULATEDLOR1LEVEL"
    },
    {
      "comment": "Region Reserve Level for LOR2 used. Can be static value or calculated value if an interconnector is a credible contingency",
      "id": 26,
      "model_type": "NUMERIC(16,6)",
      "name": "CALCULATEDLOR2LEVEL"
    },
    {
      "comment": "Net interconnector flow from the region for this interval from the MSR assessment. This field is no longer populated.",
      "id": 27,
      "model_type": "NUMERIC(12,2)",
      "name": "MSRNETINTERCHANGEUNDERSCARCITY"
    },
    {
      "comment": "Net interconnector flow from the region for this interval from the LOR assessment",
      "id": 28,
      "model_type": "NUMERIC(12,2)",
      "name": "LORNETINTERCHANGEUNDERSCARCITY"
    },
    {
      "comment": "Allowance made for non-scheduled generation in the demand forecast (MW).",
      "id": 29,
      "model_type": "NUMERIC(15,5)",
      "name": "TOTALINTERMITTENTGENERATION"
    },
    {
      "comment": "Sum of Cleared Scheduled generation, imported generation (at the region boundary) and allowances made for non-scheduled generation (MW).",
      "id": 30,
      "model_type": "NUMERIC(15,5)",
      "name": "DEMAND_AND_NONSCHEDGEN"
    },
    {
      "comment": "Regional aggregated Unconstrained Intermittent Generation Forecast of Semi-scheduled generation (MW).",
      "id": 31,
      "model_type": "NUMERIC(12,2)",
      "name": "UIGF"
    },
    {
      "comment": "Constrained generation forecast (MW) for semi-scheduled units for the region. For RELIABILITY_LRC run, semi-scheduled generation is constrained only by System Normal constraints. For OUTAGE_LRC run and LOR run, semi-scheduled generation is constrained by both System Normal and Outage constraints. All three run types (RELIABILITY_LRC, OUTAGE_LRC, LOR) incorporate MAXAVAIL limits.",
      "id": 32,
      "model_type": "NUMERIC(12,2)",
      "name": "SEMISCHEDULEDCAPACITY"
    },
    {
      "comment": "Constrained generation forecast for semi-scheduled units for the region for the LOR run. Semi-scheduled generation is constrained by both System Normal and Outage constraints, and incorporate MAXAVAIL limits.",
      "id": 33,
      "model_type": "NUMERIC(12,2)",
      "name": "LOR_SEMISCHEDULEDCAPACITY"
    },
    {
      "comment": "Largest Credible Risk. MW value for highest credible contingency",
      "id": 34,
      "model_type": "NUMERIC(16,6)",
      "name": "LCR"
    },
    {
      "comment": "Two Largest Credible Risks. MW value for highest two credible contingencies.",
      "id": 35,
      "model_type": "NUMERIC(16,6)",
      "name": "LCR2"
    },
    {
      "comment": "Forecasting Uncertainty Measure. MW value of reserve calculated as defined in the Reserve Level Declaration Guidelines",
      "id": 36,
      "model_type": "NUMERIC(16,6)",
      "name": "FUM"
    },
    {
      "comment": "Unconstrained Intermittent Generation Forecast for solar for the region. For RELIABILITY_LRC and OUTAGE_LRC run this is the POE90 forecast (determined by LRCUIGFOption in CaseSolution). For LOR run this is the POE50 forecast",
      "id": 37,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_SOLAR_UIGF"
    },
    {
      "comment": "Unconstrained Intermittent Generation Forecast for wind for the region. For RELIABILITY_LRC and OUTAGE_LRC run this is the POE90 forecast (determined by LRCUIGFOption in CaseSolution). For LOR run this is the POE50 forecast",
      "id": 38,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_WIND_UIGF"
    },
    {
      "comment": "Constrained generation forecast for solar for the region. For RELIABILITY_LRC run solar generation is constrained only by System Normal constraints. For OUTAGE_LRC run and LOR run solar generation is constrained by both System Normal and Outage constraints. All three run types (RELIABILITY_LRC, OUTAGE_LRC, LOR) incorporate MAXAVAIL limits.",
      "id": 39,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_SOLAR_CAPACITY"
    },
    {
      "comment": "Constrained generation forecast for wind for the region. For RELIABILITY_LRC run wind generation is constrained only by System Normal constraints. For OUTAGE_LRC run and LOR run wind generation is constrained by both System Normal and Outage constraints. All three run types (RELIABILITY_LRC, OUTAGE_LRC, LOR) incorporate MAXAVAIL limits.",
      "id": 40,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_WIND_CAPACITY"
    },
    {
      "comment": "Constrained generation forecast (MW) for solar for the region. For RELIABILITY_LRC run, solar generation is constrained only by System Normal constraints. For OUTAGE_LRC run and LOR run, solar generation is constrained by both System Normal and Outage constraints. All three run types (RELIABILITY_LRC, OUTAGE_LRC, LOR) incorporate MAXAVAIL limits.This value is the same as SS_SOLAR_CAPACITY.",
      "id": 41,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_SOLAR_CLEARED"
    },
    {
      "comment": "Constrained generation forecast (MW) for wind for the region. For RELIABILITY_LRC run, wind generation is constrained only by System Normal constraints. For OUTAGE_LRC run and LOR run, wind generation is constrained by both System Normal and Outage constraints. All three run types (RELIABILITY_LRC, OUTAGE_LRC, LOR) incorporate MAXAVAIL limits.This value is the same as SS_WIND_CAPACITY.",
      "id": 42,
      "model_type": "NUMERIC(12,2)",
      "name": "SS_WIND_CLEARED"
    },
    {
      "comment": "Regional aggregated Wholesale Demand Response (WDR) availability in MW.",
      "id": 43,
      "model_type": "NUMERIC(12,2)",
      "name": "WDR_AVAILABLE"
    },
    {
      "comment": "Regional aggregated Wholesale Demand Response (WDR) PASA availability in MW.",
      "id": 44,
      "model_type": "NUMERIC(12,2)",
      "name": "WDR_PASAAVAILABLE"
    },
    {
      "comment": "Regional aggregated Wholesale Demand Response (WDR) capacity in MW.",
      "id": 45,
      "model_type": "NUMERIC(12,2)",
      "name": "WDR_CAPACITY"
    }
  ],
