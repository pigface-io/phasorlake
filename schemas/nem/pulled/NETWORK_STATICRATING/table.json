      "name": "EQUIPMENTID"
    },
    {
      "comment": "The rating level of the value used, one of:\nNORM = Continuous rating value. Applied under pre-contingent conditions.\nEMER = Continuous rating value. Applied under pre-contingent conditions\nLDSH = Load Shedding",
      "first_release": "2024-08",
