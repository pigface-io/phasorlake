{
  "columns": [
    {
      "comment": "Unique identifier of predispatch run in the form YYYYMMDDPP with 01 at 04:30",
      "id": 1,
      "model_type": "VARCHAR(20)",
      "name": "PREDISPATCHSEQNO"
    },
    {
      "comment": "SPD Predispatch run no, typically 1. It increments if the case is re-run.",
      "id": 2,
      "model_type": "NUMERIC(3,0)",
      "name": "RUNNO"
    },
    {
      "comment": "Generic constraint identifier",
      "id": 3,
      "model_type": "VARCHAR(20)",
      "name": "CONSTRAINTID"
    },
    {
      "comment": "Unique period identifier, in the format yyyymmddpp. The period (pp) is 01 to 48, with 01 corresponding to the half-hour ending at 04:30am.",
      "id": 4,
      "model_type": "VARCHAR(20)",
      "name": "PERIODID"
    },
    {
      "comment": "Flag to indicate if this result set was sourced from the pricing run (INTERVENTION=0) or the physical run (INTERVENTION=1). In the event that there is not intervention in the market, both pricing and physical runs correspond to INTERVENTION=0",
      "id": 5,
      "model_type": "NUMERIC(2,0)",
      "name": "INTERVENTION"
    },
    {
      "comment": "RHS value used.",
      "id": 6,
      "model_type": "NUMERIC(15,5)",
      "name": "RHS"
    },
    {
      "comment": "Marginal value of violated constraint",
      "id": 7,
      "model_type": "NUMERIC(15,5)",
      "name": "MARGINALVALUE"
    },
    {
      "comment": "Degree of constraint violation",
      "id": 8,
      "model_type": "NUMERIC(15,5)",
      "name": "VIOLATIONDEGREE"
    },
    {
      "comment": "Last date and time record changed",
      "id": 9,
      "model_type": "TIMESTAMP(0)",
      "name": "LASTCHANGED"
    },
    {
      "comment": "Period date and time",
      "id": 10,
      "model_type": "TIMESTAMP(0)",
      "name": "DATETIME"
    },
    {
      "comment": null,
      "id": 11,
      "model_type": null,
      "name": "CONFIDENTIAL_TO"
    },
    {
      "comment": "Effective date of the Generic Constraint (ConstraintID). This field is used to track the version of this generic constraint applied in this dispatch interval",
      "id": 12,
      "model_type": "TIMESTAMP(0)",
      "name": "GENCONID_EFFECTIVEDATE"
    },
    {
      "comment": "Version number of the Generic Constraint (ConstraintID). This field is used to track the version of this generic constraint applied in this dispatch interval",
      "id": 13,
      "model_type": "NUMERIC(22,0)",
      "name": "GENCONID_VERSIONNO"
    },
    {
      "comment": "Aggregation of the constraints LHS term solution values",
      "id": 14,
      "model_type": "NUMERIC(15,5)",
      "name": "LHS"
    },
    {
      "comment": "DUID to which the Constraint is confidential. Null denotes non-confidential",
      "id": 15,
      "model_type": "VARCHAR(20)",
      "name": "DUID"
    }
  ],
  "declared": true,
  "description": "PREDISPATCHCONSTRAINT sets out constraints that are binding in each predispatch run and interconnector constraints (whether binding or not). Only binding and interconnector constraints are reported. Binding contracts have marginal value greater than $0. Interconnector constraints are listed so RHS values can be reported for ST PASA.\nConstraint solutions only report fixed loading /MR constraints on the next day.",
