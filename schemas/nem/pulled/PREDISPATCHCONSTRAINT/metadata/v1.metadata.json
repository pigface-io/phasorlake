  "schemas": [
    {
      "fields": [
        {
          "doc": "Unique identifier of predispatch run in the form YYYYMMDDPP with 01 at 04:30",
          "id": 1,
          "name": "PREDISPATCHSEQNO",
          "required": false,
          "type": "decimal(10, 0)"
        },
        {
          "doc": "SPD Predispatch run no, typically 1. It increments if the case is re-run.",
          "id": 2,
          "name": "RUNNO",
          "required": false,
          "type": "decimal(3, 0)"
        },
        {
          "doc": "Generic constraint identifier",
          "id": 3,
          "name": "CONSTRAINTID",
          "required": true,
          "type": "string"
        },
        {
          "doc": "Unique period identifier, in the format yyyymmddpp. The period (pp) is 01 to 48, with 01 corresponding to the half-hour ending at 04:30am.",
          "id": 4,
          "name": "PERIODID",
          "required": false,
          "type": "decimal(10, 0)"
        },
        {
          "doc": "Flag to indicate if this result set was sourced from the pricing run (INTERVENTION=0) or the physical run (INTERVENTION=1). In the event that there is not intervention in the market, both pricing and physical runs correspond to INTERVENTION=0",
          "id": 5,
          "name": "INTERVENTION",
          "required": false,
          "type": "decimal(2, 0)"
        },
        {
          "doc": "RHS value used.",
          "id": 6,
          "name": "RHS",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Marginal value of violated constraint",
          "id": 7,
          "name": "MARGINALVALUE",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Degree of constraint violation",
          "id": 8,
          "name": "VIOLATIONDEGREE",
          "required": false,
          "type": "decimal(15, 5)"
        },
        {
          "doc": "Last date and time record changed",
          "id": 9,
          "name": "LASTCHANGED",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "Period date and time",
          "id": 10,
          "name": "DATETIME",
          "required": true,
          "type": "timestamptz"
        },
        {
          "id": 11,
          "name": "CONFIDENTIAL_TO",
          "required": false,
          "type": "string"
        },
        {
          "doc": "Effective date of the Generic Constraint (ConstraintID). This field is used to track the version of this generic constraint applied in this dispatch interval",
          "id": 12,
          "name": "GENCONID_EFFECTIVEDATE",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "Version number of the Generic Constraint (ConstraintID). This field is used to track the version of this generic constraint applied in this dispatch interval",
          "id": 13,
          "name": "GENCONID_VERSIONNO",
          "required": false,
          "type": "double"
        }
      ],
