{
  "columns": [
    {
      "comment": "Dispatchable Unit Identifier",
      "id": 1,
      "model_type": "VARCHAR(10)",
      "name": "DUID"
    },
    {
      "comment": "Start date for effective record",
      "id": 2,
      "model_type": "TIMESTAMP(0)",
      "name": "START_DATE"
    },
    {
      "comment": "End date for effective record",
      "id": 3,
      "model_type": "TIMESTAMP(0)",
      "name": "END_DATE"
    },
    {
      "comment": "Identifies LOAD, GENERATOR or BIDIRECTIONAL. This will likely expand to more generic models as new technology types are integrated into the NEM",
      "id": 4,
      "model_type": "VARCHAR(20)",
      "name": "DISPATCHTYPE"
    },
    {
      "comment": "Country wide - Unique id of a connection point",
      "id": 5,
      "model_type": "VARCHAR(10)",
      "name": "CONNECTIONPOINTID"
    },
    {
      "comment": "Region identifier that unit is in",
      "id": 6,
      "model_type": "VARCHAR(10)",
      "name": "REGIONID"
    },
    {
      "comment": "Station that unit is in",
      "id": 7,
      "model_type": "VARCHAR(10)",
      "name": "STATIONID"
    },
    {
      "comment": "Participant that owns unit during effective record period",
      "id": 8,
      "model_type": "VARCHAR(10)",
      "name": "PARTICIPANTID"
    },
    {
      "comment": "Last date and time record changed",
      "id": 9,
      "model_type": "TIMESTAMP(0)",
      "name": "LASTCHANGED"
    },
    {
      "comment": "Used in Bidding, Dispatch and Settlements. For Bidding and Dispatch, where the DUID is a BDU with DISPATCHTYPE of BIDIRECTIONAL, the TLF for the load component of the BDU. For Settlements, where dual TLFs apply, the primary TLF is applied to all energy (load and generation) when the Net Energy Flow of the ConnectionPointID in the interval is negative (net load).",
      "id": 10,
      "model_type": "NUMERIC(15,5)",
      "name": "TRANSMISSIONLOSSFACTOR"
    },
    {
      "comment": "Unit start type. At this time restricted to Fast, Slow or Non Dispatched",
      "id": 11,
      "model_type": "VARCHAR(20)",
      "name": "STARTTYPE"
    },
    {
      "comment": "The distribution loss factor to the currently assigned connection point",
      "id": 12,
      "model_type": "NUMERIC(15,5)",
      "name": "DISTRIBUTIONLOSSFACTOR"
    },
    {
      "comment": "Floored Offer/Bid Energy Price adjusted for TLF, DLF and MPF",
      "id": 13,
      "model_type": "NUMERIC(9,2)",
      "name": "MINIMUM_ENERGY_PRICE"
    },
    {
      "comment": "Capped Offer/Bid Energy Price adjusted for TLF, DLF and VoLL",
      "id": 14,
      "model_type": "NUMERIC(9,2)",
      "name": "MAXIMUM_ENERGY_PRICE"
    },
    {
      "comment": "Scheduled status of the unit:\n    'SCHEDULED'\n    'NON-SCHEDULED'\n    'SEMI-SCHEDULED'",
      "id": 15,
      "model_type": "VARCHAR(20)",
      "name": "SCHEDULE_TYPE"
    },
    {
      "comment": "MW/Min. Calculated Minimum Ramp Rate Up value accepted for Energy Offers or Bids with explanation",
      "id": 16,
      "model_type": "NUMERIC(6,0)",
      "name": "MIN_RAMP_RATE_UP"
    },
    {
      "comment": "MW/Min. Calculated Minimum Ramp Rate Down value accepted for Energy Offers or Bids with explanation",
      "id": 17,
      "model_type": "NUMERIC(6,0)",
      "name": "MIN_RAMP_RATE_DOWN"
    },
    {
      "comment": "Maximum ramp up rate for Unit (Mw/min) - from DUDetail table",
      "id": 18,
      "model_type": "NUMERIC(6,0)",
      "name": "MAX_RAMP_RATE_UP"
    },
    {
      "comment": "Maximum ramp down rate for Unit (Mw/min) - from DUDetail table",
      "id": 19,
      "model_type": "NUMERIC(6,0)",
      "name": "MAX_RAMP_RATE_DOWN"
    },
    {
      "comment": "Whether the DUID is classified as an \"Aggregated Unit\" under the rules. This impacts the Minimum Ramp Rate calculation",
      "id": 20,
      "model_type": "NUMERIC(1,0)",
      "name": "IS_AGGREGATED"
    },
    {
      "comment": "Additional information for DISPATCHTYPE. For DISPATCHTYPE = LOAD, subtype value is WDR for wholesale demand response units For DISPATCHTYPE = LOAD, subtype value is NULL for Scheduled Loads. For DISPATCHTYPE = GENERATOR type, subtype value is NULL.",
      "id": 21,
      "model_type": "VARCHAR(20)",
      "name": "DISPATCHSUBTYPE"
    },
    {
      "comment": "Aggregate Dispatch Group. Group into which the DUID is aggregated for Conformance. Null if DUID not aggregated for Conformance",
      "id": 22,
      "model_type": "VARCHAR(20)",
      "name": "ADG_ID"
    },
    {
      "comment": "BDU only. Floored Offer/Bid Energy Price adjusted for TLF, DLF and MPF for energy imports",
      "id": 23,
      "model_type": "NUMERIC(9,2)",
      "name": "LOAD_MINIMUM_ENERGY_PRICE"
    },
    {
      "comment": "BDU only. Capped Offer/Bid Energy Price adjusted for TLF, DLF and VoLL for energy imports",
      "id": 24,
      "model_type": "NUMERIC(9,2)",
      "name": "LOAD_MAXIMUM_ENERGY_PRICE"
    },
    {
      "comment": "BDU only. MW/Min. Calculated Minimum Ramp Rate Up value accepted for Energy Offers or Bids with explanation for energy imports",
      "id": 25,
      "model_type": "NUMERIC(6,0)",
      "name": "LOAD_MIN_RAMP_RATE_UP"
    },
    {
      "comment": "BDU only. MW/Min. Calculated Minimum Ramp Rate Down value accepted for Energy Offers or Bids with explanation for energy imports",
      "id": 26,
      "model_type": "NUMERIC(6,0)",
      "name": "LOAD_MIN_RAMP_RATE_DOWN"
    },
    {
      "comment": "BDU only. MW/Min. Registered Maximum Ramp Rate Up value accepted for Energy Offers or Bids for energy imports",
      "id": 27,
      "model_type": "NUMERIC(6,0)",
      "name": "LOAD_MAX_RAMP_RATE_UP"
    },
    {
      "comment": "BDU only. MW/Min. Registered Maximum Ramp Rate Down value accepted for Energy Offers or Bids for energy imports",
      "id": 28,
      "model_type": "NUMERIC(6,0)",
      "name": "LOAD_MAX_RAMP_RATE_DOWN"
    },
    {
      "comment": "Used in Bidding, Dispatch and Settlements, only populated where Dual TLFs apply. For Bidding and Dispatch, the TLF for the generation component of a BDU, when null the TRANSMISSIONLOSSFACTOR is used for both the load and generation components. For Settlements, the secondary TLF is applied to all energy (load and generation) when the Net Energy Flow of the ConnectionPointID in the interval is positive (net generation).",
      "id": 29,
      "model_type": "NUMERIC(18,8)",
      "name": "SECONDARY_TLF"
    }
  ],
  "declared": true,
  "description": "DUDETAILSUMMARY sets out a single summary unit table so reducing the need for participants to use the various dispatchable unit detail and owner tables to establish generating unit specific details.",
