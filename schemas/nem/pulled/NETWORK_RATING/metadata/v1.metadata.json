  "properties": {
    "comment": "NETWORK_RATING defines a list of the equipment ratings that may be used as inputs to market constraints.\nIf the rating is flagged as dynamic then in real-time the rating will be dynamically determined and the static value will be used as a fallback value should the dynamic value fail.\nNote:\nIn some rare cases equipment has ratings provided from more than one TNSP. This is identified by a different SPD Id. The value used in the NEM is normally the more restrictive of the two values.",
    "utilake.declared": "true",
    "utilake.format": "4",
    "utilake.key": "[\"SPD_ID\",\"VALIDFROM\"]",
    "utilake.load": "append",
    "utilake.model-types": "{\"1\":\"VARCHAR(21)\",\"2\":\"TIMESTAMP(0)\",\"3\":\"TIMESTAMP(0)\",\"4\":\"VARCHAR(10)\",\"5\":\"VARCHAR(30)\",\"6\":\"VARCHAR(10)\",\"7\":\"VARCHAR(30)\",\"8\":\"VARCHAR(10)\",\"9\":\"NUMERIC(1,0)\",\"10\":\"TIMESTAMP(0)\"}",
    "utilake.package": "NETWORK",
    "utilake.reports": "[[\"NETWORK\",\"RATING\"]]",
