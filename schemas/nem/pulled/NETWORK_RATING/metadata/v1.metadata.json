  "schemas": [
    {
      "fields": [
        {
          "doc": "ID defining this data source for use in constraints",
          "id": 1,
          "name": "SPD_ID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The date that this record is applies from (inclusive)",
          "id": 2,
          "name": "VALIDFROM",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The date that this record applies until (exclusive)",
          "id": 3,
          "name": "VALIDTO",
          "required": false,
          "type": "timestamptz"
        },
        {
          "doc": "The region that this rating is for",
          "id": 4,
          "name": "REGIONID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The substation the equipment is located at",
          "id": 5,
          "name": "SUBSTATIONID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The type of equipment. Valid values are:\nLINE = Line\nTRANS = Transformer\nCB = Circuit breaker\nISOL = Isolator\nCAP = Capacitor\nREAC = Reactor\nUNIT = Unit",
          "id": 6,
          "name": "EQUIPMENTTYPE",
          "required": false,
          "type": "string"
        },
        {
          "doc": "A unique identifier for this equipment at this substation, and based on its type",
          "id": 7,
          "name": "EQUIPMENTID",
          "required": false,
          "type": "string"
        },
        {
          "doc": "The rating level of the value used, one of:\nNORM = Continuous rating value. Applied under pre-contingent conditions.\nEMER = Continuous rating value. Applied under pre-contingent conditions\nLDSH = Load Shedding",
          "id": 8,
          "name": "RATINGLEVEL",
          "required": false,
          "type": "string"
        },
        {
          "doc": "One of:\n1 = Normally uses dynamic ratings\n0 = No dynamic ratings, static ratings are used",
          "id": 9,
          "name": "ISDYNAMIC",
          "required": false,
          "type": "decimal(1, 0)"
        },
