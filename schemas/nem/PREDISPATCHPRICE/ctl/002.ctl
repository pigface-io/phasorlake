LOAD DATA
INFILE PUBLIC_ARCHIVE#PREDISPATCHPRICE#FILE01#202608010000.CSV
APPEND INTO TABLE PREDISPATCHPRICE
WHEN (1:1) = 'D'
FIELDS TERMINATED BY ','
