TRAILING NULLCOLS
(row_type FILLER,
report_type FILLER,
report_subtype FILLER,
report_version FILLER,
PREDISPATCHSEQNO CHAR(20),
RUNNO FLOAT EXTERNAL,
REGIONID CHAR(10),
PERIODID CHAR(20),
INTERVENTION FLOAT EXTERNAL,
RRP FLOAT EXTERNAL,
EEP FLOAT EXTERNAL,
RRP1 FLOAT EXTERNAL,
EEP1 FLOAT EXTERNAL,
RRP2 FLOAT EXTERNAL,
EEP2 FLOAT EXTERNAL,
RRP3 FLOAT EXTERNAL,
EEP3 FLOAT EXTERNAL,
RRP4 FLOAT EXTERNAL,
EEP4 FLOAT EXTERNAL,
RRP5 FLOAT EXTERNAL,
EEP5 FLOAT EXTERNAL,
RRP6 FLOAT EXTERNAL,
EEP6 FLOAT EXTERNAL,
RRP7 FLOAT EXTERNAL,
EEP7 FLOAT EXTERNAL,
RRP8 FLOAT EXTERNAL,
EEP8 FLOAT EXTERNAL,
LASTCHANGED DATE "YYYY/MM/DD HH24:MI:SS",
DATETIME DATE "YYYY/MM/DD HH24:MI:SS",
RAISE6SECRRP FLOAT EXTERNAL,
RAISE60SECRRP FLOAT EXTERNAL,
