LOAD DATA
INFILE PUBLIC_DVD_MTPASA_REGIONRESULT_201910010000.CSV
APPEND INTO TABLE MTPASA_REGIONRESULT
WHEN (1:1) = 'D'
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(row_type FILLER,
report_type FILLER,
report_subtype FILLER,
report_version FILLER,
RUN_DATETIME DATE "yyyy/mm/dd hh24:mi:ss",
RUN_NO FLOAT EXTERNAL,
RUNTYPE CHAR(20),
DEMAND_POE_TYPE CHAR(20),
DAY DATE "yyyy/mm/dd hh24:mi:ss",
REGIONID CHAR(20),
PERIODID FLOAT EXTERNAL,
DEMAND FLOAT EXTERNAL,
AGGREGATEINSTALLEDCAPACITY FLOAT EXTERNAL,
NUMBEROFITERATIONS FLOAT EXTERNAL,
USE_NUMBEROFITERATIONS FLOAT EXTERNAL,
USE_MAX FLOAT EXTERNAL,
USE_UPPERQUARTILE FLOAT EXTERNAL,
USE_MEDIAN FLOAT EXTERNAL,
USE_LOWERQUARTILE FLOAT EXTERNAL,
USE_MIN FLOAT EXTERNAL,
USE_AVERAGE FLOAT EXTERNAL,
USE_EVENT_AVERAGE FLOAT EXTERNAL,
TOTALSCHEDULEDGEN90 FLOAT EXTERNAL,
TOTALSCHEDULEDGEN50 FLOAT EXTERNAL,
TOTALSCHEDULEDGEN10 FLOAT EXTERNAL,
TOTALINTERMITTENTGEN90 FLOAT EXTERNAL,
TOTALINTERMITTENTGEN50 FLOAT EXTERNAL,
TOTALINTERMITTENTGEN10 FLOAT EXTERNAL,
DEMANDSIDEPARTICIPATION90 FLOAT EXTERNAL,
DEMANDSIDEPARTICIPATION50 FLOAT EXTERNAL,
DEMANDSIDEPARTICIPATION10 FLOAT EXTERNAL,
LASTCHANGED DATE "yyyy/mm/dd hh24:mi:ss",
TOTALSEMISCHEDULEDGEN90 FILLER,
TOTALSEMISCHEDULEDGEN50 FILLER,
TOTALSEMISCHEDULEDGEN10 FILLER)
-- End of Script
