-- ************************************************************
-- Title:	PUBLIC_ARCHIVE#PMS_GROUP#FILE01#202608.ctl
-- ************************************************************
-- Project : NEMMCO MONTHLY DVD RELEASE
-- Purpose : Control File to load monthly csv file
-- Target Application  : Monthly DVD Release
-- Application Version : 1
-- Visibility Id : PUBLIC
--
-- ************************************************************
-- Special Instructions : 1. USER TO CONNECT AS PMS_GROUP owner
--
-- ************************************************************
-- History :
--      MMS Data Model Version   Template Generated On
--      ======================   ======================
--      PUBLIC			       v
-- ************************************************************
LOAD DATA
INFILE PUBLIC_ARCHIVE#PMS_GROUP#FILE01#202608010000.CSV
APPEND INTO TABLE PMS_GROUP
WHEN (1:1) = 'D'
FIELDS TERMINATED BY ','
OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(row_type FILLER,
report_type FILLER,
report_subtype FILLER,
report_version FILLER,
GROUPID FLOAT EXTERNAL,
CREATEDDATE TIMESTAMP(3),
LASTCHANGED TIMESTAMP(3))
-- End of Script
